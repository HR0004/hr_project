<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" %>

<%
    String sidebarUri = request.getRequestURI();
    String sidebarContextPath = request.getContextPath();

    boolean sidebarDepartmentActive =
        sidebarUri.startsWith(sidebarContextPath + "/departments");

    boolean sidebarJobActive =
        sidebarUri.startsWith(sidebarContextPath + "/jobs");

    boolean sidebarEmployeeActive =
        sidebarUri.startsWith(sidebarContextPath + "/employees");

    boolean sidebarAttendanceActive =
        sidebarUri.startsWith(sidebarContextPath + "/attendance")
        || sidebarUri.startsWith(sidebarContextPath + "/test/attendance");
%>

<!-- 사이드바 -->
<aside class="main-sidebar sidebar-light-primary elevation-0">

    <!-- 로고 -->
    <a href="#" class="brand-link">
        <span class="brand-text">
            ▦ HRMS Admin
        </span>
    </a>

    <div class="sidebar">

        <div class="sidebar-title">
            인사관리 시스템
        </div>

        <!-- 메뉴 -->
        <nav class="mt-2">

            <ul class="nav nav-pills nav-sidebar flex-column"
                role="menu">

                <li class="nav-item">
                    <a href="<%=sidebarContextPath%>/departments"
                       class="nav-link <%=sidebarDepartmentActive ? "active" : ""%>">
                        <p>01 부서 관리</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="<%=sidebarContextPath%>/jobs"
                       class="nav-link <%=sidebarJobActive ? "active" : ""%>">
                        <p>02 직급 관리</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="<%=sidebarContextPath%>/employees"
                       class="nav-link <%=sidebarEmployeeActive ? "active" : ""%>">
                        <p>03 사원 관리</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="<%=sidebarContextPath%>/test/attendance.jsp"
                       class="nav-link <%=sidebarAttendanceActive ? "active" : ""%>">
                        <p>04 근태 관리</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="#" class="nav-link">
                        <p>05 휴가 관리</p>
                    </a>
                </li>

                <li class="nav-item">
                    <a href="#" class="nav-link">
                        <p>06 급여 관리</p>
                    </a>
                </li>

            </ul>
        </nav>

    </div>
</aside>