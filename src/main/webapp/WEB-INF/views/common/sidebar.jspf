<%@ page pageEncoding="UTF-8" %>

<style>
    .main-sidebar {
        height: 100vh;
        background-color: #ffffff;
        color: #374151;
        position: fixed;
        width: 240px;
        top: 0;
        left: 0;
        padding-top: 24px;
        border-right: 1px solid #e5e7eb;
        z-index: 1000;
        box-sizing: border-box;
    }
    .sidebar-logo {
        font-size: 16px;
        font-weight: bold;
        padding: 0 24px 16px 24px;
        color: #111827;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .sidebar-title {
        font-size: 12px;
        padding: 0 24px 16px 24px;
        color: #9ca3af;
        font-weight: 500;
    }
    .sidebar-menu {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 0 12px;
    }
    .sidebar-menu .menu-item {
        color: #4b5563;
        padding: 12px 16px;
        display: block;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        border-radius: 8px;
        white-space: nowrap;
        transition: background-color 0.15s, color 0.15s;
    }
    .sidebar-menu .menu-item:hover {
        background-color: #f3f4f6;
        color: #111827;
        text-decoration: none;
    }
    .sidebar-menu .menu-item.active {
        color: #1d4ed8;
        background-color: #eff6ff;
        font-weight: 600;
        text-decoration: none;
    }

    .main-area {
        margin-left: 240px !important;
    }
</style>

<aside class="main-sidebar">
    <div class="sidebar-logo">
        <span style="font-size: 14px;">田</span> HRMS Admin
    </div>
    <div class="sidebar-title">인사관리 시스템</div>

    <nav class="sidebar-menu">
        <a href="${pageContext.request.contextPath}/dashboard" class="menu-item active">
            00 대시보드
        </a>
        <a href="${pageContext.request.contextPath}/departments" class="menu-item">
            01 부서 관리
        </a>
        <a href="#" class="menu-item">
            02 직급 관리
        </a>
        <a href="${pageContext.request.contextPath}/employees" class="menu-item">
            03 사원 관리
        </a>
        <a href="${pageContext.request.contextPath}/attendance" class="menu-item">
            04 근태 관리
        </a>
        <a href="${pageContext.request.contextPath}/leave" class="menu-item">
            05 휴가 관리
        </a>
        <a href="${pageContext.request.contextPath}/admin/accounts/1" class="menu-item">
            06 권한 관리
        </a>
    </nav>
</aside>