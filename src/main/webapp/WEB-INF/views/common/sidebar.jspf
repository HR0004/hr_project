<%@ page pageEncoding="UTF-8" %>

<style>
body .main-sidebar.hrms-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: 240px !important;
    height: 100vh;
    padding-top: 24px;
    background: #fff;
    color: #374151;
    border-right: 1px solid #e5e7eb;
    box-sizing: border-box;
    overflow-y: auto;
    overflow-x: hidden;
    z-index: 1000;
    transform: translateX(0) !important;
    transition: transform 0.2s ease;
}

.hrms-sidebar .sidebar-logo {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 24px 16px;
    color: #111827;
    font-size: 16px;
    font-weight: bold;
}

.hrms-sidebar .sidebar-title {
    padding: 0 24px 16px;
    color: #9ca3af;
    font-size: 12px;
    font-weight: 500;
}

.hrms-sidebar .sidebar-menu {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0 12px;
}

.hrms-sidebar .sidebar-menu .menu-item {
    display: block;
    padding: 12px 16px;
    border-radius: 8px;
    color: #4b5563;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    transition: background-color 0.15s, color 0.15s;
}

.hrms-sidebar .sidebar-menu .menu-item:hover {
    background: #f3f4f6;
    color: #111827;
    text-decoration: none;
}

.hrms-sidebar .sidebar-menu .menu-item.active {
    background: #eff6ff;
    color: #1d4ed8;
    font-weight: 600;
}

/* 펼친 상태의 본문 여백 */
body .main-area,
body .content-wrapper {
    margin-left: 240px !important;
    min-width: 0;
    transition: margin-left 0.2s ease;
}

/* 본문이 중첩된 경우 여백 중복 방지 */
body .content-wrapper .main-area {
    margin-left: 0 !important;
}

body > .main-header,
body .wrapper > .main-header {
    margin-left: 240px !important;
}

/* 접은 상태 */
body.sidebar-collapse .main-sidebar.hrms-sidebar {
    width: 240px !important;
    transform: translateX(-100%) !important;
    visibility: hidden;
    pointer-events: none;
}

body.sidebar-collapse .main-area,
body.sidebar-collapse .content-wrapper,
body.sidebar-collapse > .main-header,
body.sidebar-collapse .wrapper > .main-header {
    margin-left: 0 !important;
}
</style>

<aside class="main-sidebar hrms-sidebar" id="hrms-sidebar">

    <div class="sidebar-logo">
        <span style="font-size: 14px;">田</span>
        HRMS Admin
    </div>

    <div class="sidebar-title">인사관리 시스템</div>

    <nav class="sidebar-menu"
         id="hrms-sidebar-menu"
         data-context-path="${pageContext.request.contextPath}">

        <a href="${pageContext.request.contextPath}/dashboard"
           class="menu-item"
           data-menu-path="/dashboard">
            00 대시보드
        </a>

        <a href="${pageContext.request.contextPath}/departments"
           class="menu-item"
           data-menu-path="/departments">
            01 부서 관리
        </a>

        <a 	href="${pageContext.request.contextPath}/jobs" 
        	class="menu-item"
        	data-menu-path="/jobs">
            02 직급 관리
        </a>

        <a href="${pageContext.request.contextPath}/employees"
           class="menu-item"
           data-menu-path="/employees">
            03 사원 관리
        </a>

        <a href="${pageContext.request.contextPath}/attendance"
           class="menu-item"
           data-menu-path="/attendance">
            04 근태 관리
        </a>

        <a href="${pageContext.request.contextPath}/leave"
           class="menu-item"
           data-menu-path="/leave">
            05 휴가 관리
        </a>

        <a href="${pageContext.request.contextPath}/admin/accounts/1"
           class="menu-item"
           data-menu-path="/admin/accounts">
            06 권한 관리
        </a>

    </nav>
</aside>

<script>
(function () {
    var menu = document.getElementById("hrms-sidebar-menu");

    if (!menu) {
        return;
    }

    var contextPath = menu.getAttribute("data-context-path") || "";
    var currentPath = window.location.pathname;

    if (contextPath &&
        (currentPath === contextPath ||
         currentPath.indexOf(contextPath + "/") === 0)) {
        currentPath = currentPath.substring(contextPath.length);
    }

    currentPath = currentPath.replace(/\/+$/, "") || "/";

    // 현재 화면에 해당하는 메뉴 선택
    Array.prototype.forEach.call(
        menu.querySelectorAll(".menu-item"),
        function (link) {
            var path = link.getAttribute("data-menu-path");

            var selected = Boolean(path && (
                currentPath === path ||
                currentPath.indexOf(path + "/") === 0 ||
                (currentPath === "/" && path === "/dashboard")
            ));

            link.classList.toggle("active", selected);

            if (selected) {
                link.setAttribute("aria-current", "page");
            } else {
                link.removeAttribute("aria-current");
            }
        }
    );

    // 접기 이벤트 중복 등록 방지
    if (document.documentElement.hasAttribute("data-hrms-sidebar-ready")) {
        return;
    }

    document.documentElement.setAttribute(
        "data-hrms-sidebar-ready", "true"
    );

    function updateToggleState() {
        var expanded = !document.body.classList.contains(
            "sidebar-collapse"
        );

        Array.prototype.forEach.call(
            document.querySelectorAll('[data-widget="pushmenu"]'),
            function (button) {
                button.setAttribute("aria-expanded", String(expanded));
                button.setAttribute("aria-controls", "hrms-sidebar");
            }
        );
    }

    document.addEventListener("click", function (event) {
        if (!(event.target instanceof Element)) {
            return;
        }

        var button = event.target.closest(
            '[data-widget="pushmenu"]'
        );

        if (!button) {
            return;
        }

        event.preventDefault();
        event.stopImmediatePropagation();

        document.body.classList.remove(
            "sidebar-open", "sidebar-closed"
        );

        document.body.classList.toggle("sidebar-collapse");

        updateToggleState();
    }, true);

    if (document.readyState === "loading") {
        document.addEventListener(
            "DOMContentLoaded", updateToggleState
        );
    } else {
        updateToggleState();
    }
})();
</script>