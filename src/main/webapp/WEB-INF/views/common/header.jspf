<%@ page pageEncoding="UTF-8" %>

<style>
.hrms-common-header {
    display: flex;
    align-items: center;
    gap: 16px;
}

.hrms-common-header > .navbar-nav {
    display: flex;
    align-items: center;
    list-style: none;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
}

.hrms-common-header > .navbar-nav.ml-auto {
    margin-left: auto;
}

.hrms-common-header .admin-profile-container {
    position: relative;
    display: inline-block;
}

.hrms-common-header .profile-btn {
    background: #fff;
    border: 1px solid #e2e8f0;
    padding: 8px 20px;
    border-radius: 8px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.02);
    color: #334155;
}

.hrms-common-header .profile-dropdown {
    display: none;
    position: absolute;
    right: 0;
    top: 100%;
    width: 220px;
    padding: 8px 0;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.08);
    z-index: 1100;
}

.hrms-common-header .admin-profile-container:hover .profile-dropdown,
.hrms-common-header .admin-profile-container:focus-within .profile-dropdown {
    display: block;
}

.hrms-common-header .dropdown-header {
    padding: 10px 16px;
    font-size: 13px;
    color: #475569;
    border-bottom: 1px solid #f1f5f9;
    margin-bottom: 4px;
}

.hrms-common-header .dropdown-item {
    display: block;
    padding: 10px 16px;
    color: #334155;
    text-decoration: none;
    font-size: 13px;
    white-space: normal;
}

.hrms-common-header .dropdown-item:hover,
.hrms-common-header .dropdown-item:focus {
    background: #f8fafc;
}

.hrms-common-header .dropdown-item.highlight {
    background: #f1f5f9;
    font-weight: 500;
}

.hrms-common-header .dropdown-item.danger {
    color: #dc2626;
}

/* 사이드바 접기 버튼 */
.hrms-common-header .hrms-sidebar-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 8px;
    padding: 0;
    background: #fff;
    color: #475569;
    font-family: inherit;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
}

.hrms-common-header .hrms-sidebar-toggle:focus-visible {
    outline: 2px solid #2563eb;
    outline-offset: 2px;
}

/* 왼쪽 접기 버튼 / 가운데 제목 / 오른쪽 관리자 */
body .top-nav-bar {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    column-gap: 16px;
    align-items: start;
    position: relative;
    min-height: 44px;
    padding-left: 0 !important;
    margin-bottom: 32px;
}

body .top-nav-bar > .page-title-area {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
}

body .top-nav-bar > .page-title-area h1,
body .top-nav-bar > .page-title-area h2 {
    margin: 0;
    color: #0f172a;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.4;
}

body .top-nav-bar > .hrms-common-header.main-header {
    display: contents !important;
    position: static !important;
    margin: 0 !important;
    padding: 0;
    background: transparent;
    border: 0;
    box-shadow: none;
}

body .top-nav-bar > .hrms-common-header > .navbar-nav:first-child {
    position: static !important;
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    padding: 0;
}

body .top-nav-bar > .hrms-common-header > .navbar-nav:last-child {
    grid-column: 3;
    grid-row: 1;
    margin: 0;
    padding: 0;
}

@media (max-width: 600px) {
    body .top-nav-bar {
        column-gap: 10px;
    }

    body .top-nav-bar > .page-title-area h1,
    body .top-nav-bar > .page-title-area h2 {
        font-size: 20px;
    }

    .hrms-common-header .profile-btn {
        padding: 8px 12px;
    }
}
</style>

<nav class="main-header navbar navbar-expand navbar-white navbar-light hrms-common-header"
     aria-label="상단 사용자 메뉴">

    <!-- 왼쪽 사이드바 접기 버튼 -->
    <ul class="navbar-nav">
        <li class="nav-item">
            <button type="button"
                    class="nav-link hrms-sidebar-toggle"
                    data-widget="pushmenu"
                    aria-controls="hrms-sidebar"
                    aria-expanded="true"
                    aria-label="사이드바 접기 또는 펼치기">
                <span aria-hidden="true">&#9776;</span>
            </button>
        </li>
    </ul>

    <!-- 오른쪽 관리자 메뉴 -->
    <ul class="navbar-nav ml-auto">
        <li class="nav-item">
            <div class="admin-profile-container">

                <button type="button" class="profile-btn">
                    관리자
                </button>

                <div class="profile-dropdown">
                    <div class="dropdown-header">
                        정하늘 팀장 · 백엔드팀
                    </div>

                    <a href="${pageContext.request.contextPath}/mypage"
                       class="dropdown-item">
                        내 정보
                    </a>

                    <a href="${pageContext.request.contextPath}/admin/accounts/1"
                       class="dropdown-item highlight">
                        권한 위임 관리
                    </a>

                    <a href="${pageContext.request.contextPath}/logout"
                       class="dropdown-item danger">
                        로그아웃
                    </a>
                </div>

            </div>
        </li>
    </ul>

</nav>